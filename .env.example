# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# 1. Copy this file to .env.local for local development
# 2. Fill in all required values (marked with *)
# 3. Never commit .env.local to version control
# 4. For production, set these in your deployment platform (Vercel, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js) *
# -----------------------------------------------------------------------------
# NEXTAUTH_SECRET: Generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=

# GitHub OAuth App Credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL) *
# -----------------------------------------------------------------------------
# Neon, Supabase, or any PostgreSQL connection string
# Example: postgres://user:password@host.region.neon.tech/dbname?sslmode=require
DATABASE_URL='postgres://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require'

# -----------------------------------------------------------------------------
# Cloudflare CMS API
# -----------------------------------------------------------------------------
# Worker URL - Your deployed Cloudflare Worker endpoint
# Development: http://localhost:8787/api/cms (when running wrangler dev)
# Production: https://cms-api.your-subdomain.workers.dev/api/cms
NEXT_PUBLIC_CMS_API_URL=http://localhost:8787/api/cms

# Admin API Secret - Used to authenticate admin operations (cache invalidation, rebuilds)
# Generate a secure random string for production
CMS_API_SECRET=your-secure-admin-secret-here

# HuggingFace Token - Required for fetching datasets (read access)
# Get your token from: https://huggingface.co/settings/tokens
# Only needed if you want to test the Worker locally with actual HuggingFace data
HF_TOKEN=your-huggingface-read-token

# -----------------------------------------------------------------------------
# DEPLOYMENT INSTRUCTIONS
# -----------------------------------------------------------------------------
#
# LOCAL DEVELOPMENT:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in required values (marked with *)
# 3. Run Cloudflare Worker: cd workers/cms-api && wrangler dev
# 4. Run Next.js: pnpm dev
#
# PRODUCTION DEPLOYMENT:
#
# Cloudflare Worker:
# 1. cd workers/cms-api
# 2. Update wrangler.toml with your database IDs
# 3. Set secrets: wrangler secret put HF_TOKEN
#                 wrangler secret put ADMIN_SECRET
# 4. Deploy: wrangler deploy
# 5. Copy Worker URL (e.g., https://cms-api.your-subdomain.workers.dev)
#
# Next.js (Vercel):
# 1. Set environment variables in Vercel dashboard
# 2. NEXT_PUBLIC_CMS_API_URL = <your-worker-url>/api/cms
# 3. Deploy as normal
#
# For detailed migration guide, see: MIGRATION_ADMIN.md
# -----------------------------------------------------------------------------
